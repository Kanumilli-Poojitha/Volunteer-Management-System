# Copy these into your shell / IDE run configuration / deployment secrets. Do NOT commit real values.
# Spring Boot reads them as environment variables (it does not load .env files by itself).

# --- Database (MySQL 8+) ---
DB_URL=jdbc:mysql://localhost:3306/volunteerhub
DB_USERNAME=volunteerhub
DB_PASSWORD=change-me

# --- JWT ---
# REQUIRED. At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Token lifetime, e.g. 30m, 1h, 8h
JWT_EXPIRATION=1h

# --- CORS: comma-separated browser origins allowed to call the API ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional: create the first ADMIN at startup (only if no ADMIN exists). Remove after first run. ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
